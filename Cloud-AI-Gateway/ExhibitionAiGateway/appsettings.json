{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiProvider": {
    "Provider": "OpenAI"
  },
  "Gateway": {
    "MaxInputChars": 1000
  },
  "Rag": {
    "RerankEnabled": true,
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingEndpoint": "https://api.openai.com/v1/embeddings",
    "MaxContextAfterRerank": 3,
    "MinRerankScore": 0
  },
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "ResponsesEndpoint": "https://api.openai.com/v1/responses",
    "TimeoutSeconds": 30,
    "SystemPrompt": "You are an AI guide for an interactive Unreal Engine exhibition. Answer in Korean by default. Keep replies concise, helpful, and safe."
  },
  "Gemini": {
    "Model": "gemini-2.0-flash-lite",
    "TimeoutSeconds": 30
  },
  "Groq": {
    "Model": "llama-3.1-8b-instant",
    "TimeoutSeconds": 30
  },
  "LocalLlm": {
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "gemma3:4b",
    "ApiStyle": "Ollama",
    "TimeoutSeconds": 60
  },
  "GatewaySecurity": {
    "HeaderName": "X-AI-Gateway-Key"
  },
  "AiRateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}

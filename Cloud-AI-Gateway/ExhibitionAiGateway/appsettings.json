{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiProvider": {
    "Provider": "OpenAI"
  },
  "Gateway": {
    "MaxInputChars": 3000
  },
  "Rag": {
    "RerankEnabled": true,
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingEndpoint": "https://api.openai.com/v1/embeddings",
    "MaxContextAfterRerank": 3,
    "MinRerankScore": 0
  },
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "ResponsesEndpoint": "https://api.openai.com/v1/responses",
    "TimeoutSeconds": 30,
    "SystemPrompt": "You are an AI guide for an interactive Unreal Engine exhibition. Answer in Korean by default. Keep replies concise, helpful, and safe. 인사 질문에는 '안녕하세요'로 시작하지 말고 바로 본론으로 답해. 예: '반갑습니다! 무엇이 궁금하세요?' 또는 '어서오세요! 트리케라톱스부터 소개해드릴까요?'"
  },
  "Gemini": {
    "Model": "gemini-2.0-flash-lite",
    "TimeoutSeconds": 30
  },
  "Groq": {
    "Model": "llama-3.1-8b-instant",
    "TimeoutSeconds": 30
  },
  "LocalLlm": {
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "gemma3:4b",
    "ApiStyle": "Ollama",
    "TimeoutSeconds": 60
  },
  "Voice": {
    "SttModel": "whisper-1",
    "SttEndpoint": "https://api.openai.com/v1/audio/transcriptions",
    "TtsModel": "gpt-4o-mini-tts",
    "TtsEndpoint": "https://api.openai.com/v1/audio/speech",
    "DefaultVoice": "alloy",
    "TtsInstructions": "한국어로 또렷하고 명확하게 발음해. 단어를 늘이거나 감정을 과장하지 마. 짧고 깔끔하게 말하되, 친근하고 밝은 전시 가이드 톤을 유지해.",
    "TtsResponseFormat": "wav"
  },
  "GatewaySecurity": {
    "HeaderName": "X-AI-Gateway-Key"
  },
  "AiRateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5225"
      }
    }
  },
  "AiGateway": {
    "Enabled": true,
    "HeaderName": "X-AI-Gateway-Key",
    "TimeoutSeconds": 20
  },
  "KnowledgeSearch": {
    "EmbeddingsEnabled": false,
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingEndpoint": "https://api.openai.com/v1/embeddings",
    "KeywordWeight": 0.35,
    "VectorWeight": 0.65,
    "MinHybridScore": 0.12
  }
}
